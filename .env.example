# Copy to .env for local development:  cp .env.example .env
#
# The only required setting for local dev is a Databricks auth profile (used to call the model).
# Local dev uses SQLite under .agentbricks/ for session checkpoints and long-term memory.
# Invocation requests, results and event cursors persist in .agentbricks/local_agent_runtime.db.

# Databricks auth profile (from `databricks auth profiles`). Used to call the model endpoint.
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Comma-separated authenticated workspace users permitted to read across users and run pipelines.
# AGENT_ADMIN_USERS=
# Or use explicit host/token instead of a profile:
# DATABRICKS_HOST=https://<your-workspace>.databricks.com
# DATABRICKS_TOKEN=dapi...

# --- Local MLflow tracing ---
# app.local.yaml enables embedded SQLite tracing. The authenticated workbench serves session
# traces to application administrators; no standalone MLflow HTTP server is needed.
# The deployed tracking destination and experiment are configured by Agent Bricks.

# --- Optional: long-term memory tools ---
# agentbricks dev defaults to .agentbricks/local_agent_memory.db. Set a managed memory store ID
# to use that store instead. Reuse input.actor across sessions to recall a user's saved facts.
# AGENT_MEMORY_STORE=<memory-store-id>

# --- Optional: durable state (managed Session Store) ---
# agentbricks dev defaults to SQLite for conversation checkpoints, including pending approvals.
# Set this only to use an existing managed Session Store with your Databricks identity.
# AGENT_SESSION_STORE=my-agent-sessions
